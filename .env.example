# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
TELEGRAM_ALLOWED_USER_IDS=123456789

# ---------------------------------------------------------------------------
# Leitura de historico de grupos (opcional)
# ---------------------------------------------------------------------------
# O Bot API NAO le historico: um bot so recebe o que chega depois de entrar no
# grupo. Para ler o passado e preciso um cliente MTProto com a SUA conta.
#
# Como configurar:
#   1. Pegue api_id e api_hash em https://my.telegram.org -> API development tools
#   2. npm run telegram:login    (login por telefone + codigo; imprime a sessao
#                                 e lista seus grupos com os ids)
#   3. Cole a sessao e os ids desejados abaixo
#   4. Depois, para so reler a lista de grupos: npm run telegram:login -- --listar
#
# As quatro variaveis andam juntas: definir uma sem as outras falha no boot, de
# proposito — config pela metade sobe um bot que parece saudavel e nunca le nada.
#
# RISCOS, leia antes de ligar:
#   - TELEGRAM_SESSION equivale a estar logado na sua conta. Trate como senha.
#   - Automatizar uma conta de usuario ("userbot") e zona cinzenta no ToS do
#     Telegram; o risco de limitacao ou ban recai na sua conta pessoal.
#   - O conteudo dos grupos fica em texto claro no SQLite em DB_PATH.
#
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_SESSION=1BQANOTEuMTA4...
# TELEGRAM_GROUP_IDS=-1001111111111,-1002222222222
#
# Quantas mensagens puxar por grupo. Na primeira execucao e a profundidade do
# historico; depois, o teto de recuperacao por reinicio. Padrao 500.
# TELEGRAM_BACKFILL_LIMIT=500

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
# Option A: OpenRouter (recommended - one key for every model)
#
#   OPENROUTER_API_KEY=sk-or-...
#
#   LLM_PROVIDER / LLM_PROVIDERS accept either a short alias or ANY raw
#   OpenRouter model slug. Raw slugs are the safer choice: aliases are a
#   hardcoded list in src/providers/openrouter-provider.ts and go stale when
#   OpenRouter delists a model.
#
#   Aliases: gemini, deepseek, nemotron, nemotron-super
#
#   Watch out for:
#     - models WITHOUT a ":free" suffix bill against credits and return
#       402 Payment Required on a zero-credit key (this includes "gemini")
#     - free models are rate-limited and return 429, or 503 when the upstream
#       vendor is overloaded; always configure fallbacks
#
#   Free models verified working with tool calling on 2026-10-17:
#     dots-studio/dots-3-note-preview:free
#     xingchen-agi/xing4.0-29b-a4b:free
#     cohere/north-mini-code:free
#
# Option B: Native APIs (a separate key per provider)
#     LLM_PROVIDER=openai
#     LLM_PROVIDERS=openai,deepseek
#     OPENAI_API_KEY=sk-...
#     GEMINI_API_KEY=...
#     DEEPSEEK_API_KEY=...
#     GROQ_API_KEY=...
#
#   Nome de modelo envelhece mais rapido que este repositorio. Cada provedor
#   nativo aceita <PROVEDOR>_MODEL para sobrescrever o padrao sem editar codigo:
#     OPENAI_MODEL=gpt-4o-mini        (padrao atual do preset)
#     GEMINI_MODEL=gemini-2.0-flash
#     DEEPSEEK_MODEL=deepseek-chat
#     GROQ_MODEL=llama-3.3-70b-versatile
#   Se o boot comecar a dar 404 ou "model not found", e aqui que se conserta.
#
# Option C (recomendada): misturar as duas. A chave nativa de um provedor tem
# precedencia sobre o OpenRouter PARA AQUELE PROVEDOR; o OpenRouter cobre o resto
# da cadeia. Da um primario direto e confiavel com fallback gratuito atras:
#
#     OPENROUTER_API_KEY=sk-or-...
#     OPENAI_API_KEY=sk-...
#     LLM_PROVIDER=openai
#     LLM_PROVIDERS=dots-studio/dots-3-note-preview:free,nemotron
#
#   Aqui "openai" vai direto para a API da OpenAI e os outros dois pelo OpenRouter.
#   Sem a chave nativa, um provedor com alias pago no OpenRouter devolve 402 numa
#   chave sem credito.
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-...
LLM_PROVIDER=dots-studio/dots-3-note-preview:free
LLM_PROVIDERS=xingchen-agi/xing4.0-29b-a4b:free,cohere/north-mini-code:free

# Agent Loop
# 5 serve para conversa; documentos grandes precisam de ~12 (ver specs/configuration.md 3.2)
MAX_ITERATIONS=5
LLM_TIMEOUT_MS=120000
LLM_RETRY_COUNT=3
LLM_RETRY_BASE_DELAY_MS=1000
TOOL_TIMEOUT_MS=30000

# Memory
MEMORY_WINDOW_SIZE=20
DB_PATH=./data/db.sqlite
DB_MAX_SIZE_MB=500

# Filesystem
WORKSPACE_ROOT=./output
TMP_DIR=./tmp
SKILLS_DIR=./agents/skills

# Logging
LOG_MESSAGE_CONTENT=false

# Audio (STT/TTS) - optional; voice is disabled automatically if these are missing.
#
# Run `npm run setup:whisper` to download the whisper.cpp CLI and the ggml model.
# Voice output needs edge-tts: `pip install edge-tts`.
#
# WHISPER_BINARY / EDGE_TTS_BINARY accept a bare name (resolved on PATH) or a full
# path - pip and the whisper.cpp build both land outside PATH on Windows.
#
# WHISPER_LANGUAGE matters: without it whisper assumes English and TRANSLATES the
# audio instead of transcribing it.
WHISPER_BINARY=bin/whisper/Release/whisper-cli.exe
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt
TTS_VOICE_ID=pt-BR-ThalitaMultilingualNeural
FFMPEG_BINARY=ffmpeg
EDGE_TTS_BINARY=edge-tts
