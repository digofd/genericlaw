# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
TELEGRAM_ALLOWED_USER_IDS=123456789

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
# Option A: OpenRouter (recommended - one key for every model)
#
#   OPENROUTER_API_KEY=sk-or-...
#
#   LLM_PROVIDER / LLM_PROVIDERS accept either a short alias or ANY raw
#   OpenRouter model slug. Raw slugs are the safer choice: aliases are a
#   hardcoded list in src/providers/openrouter-provider.ts and go stale when
#   OpenRouter delists a model.
#
#   Aliases: gemini, deepseek, nemotron, nemotron-super
#
#   Watch out for:
#     - models WITHOUT a ":free" suffix bill against credits and return
#       402 Payment Required on a zero-credit key (this includes "gemini")
#     - free models are rate-limited and return 429, or 503 when the upstream
#       vendor is overloaded; always configure fallbacks
#
#   Free models verified working with tool calling on 2026-10-17:
#     dots-studio/dots-3-note-preview:free
#     xingchen-agi/xing4.0-29b-a4b:free
#     cohere/north-mini-code:free
#
# Option B: Native APIs (a separate key per provider; leave OPENROUTER_API_KEY unset)
#     LLM_PROVIDER=gemini
#     LLM_PROVIDERS=gemini,deepseek
#     GEMINI_API_KEY=...
#     DEEPSEEK_API_KEY=...
#     GROQ_API_KEY=...
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-...
LLM_PROVIDER=dots-studio/dots-3-note-preview:free
LLM_PROVIDERS=xingchen-agi/xing4.0-29b-a4b:free,cohere/north-mini-code:free

# Agent Loop
# 5 serve para conversa; documentos grandes precisam de ~12 (ver specs/configuration.md 3.2)
MAX_ITERATIONS=5
LLM_TIMEOUT_MS=120000
LLM_RETRY_COUNT=3
LLM_RETRY_BASE_DELAY_MS=1000
TOOL_TIMEOUT_MS=30000

# Memory
MEMORY_WINDOW_SIZE=20
DB_PATH=./data/db.sqlite
DB_MAX_SIZE_MB=500

# Filesystem
WORKSPACE_ROOT=./output
TMP_DIR=./tmp
SKILLS_DIR=./agents/skills

# Logging
LOG_MESSAGE_CONTENT=false

# Audio (STT/TTS) - optional; voice is disabled automatically if these are missing.
#
# Run `npm run setup:whisper` to download the whisper.cpp CLI and the ggml model.
# Voice output needs edge-tts: `pip install edge-tts`.
#
# WHISPER_BINARY / EDGE_TTS_BINARY accept a bare name (resolved on PATH) or a full
# path - pip and the whisper.cpp build both land outside PATH on Windows.
#
# WHISPER_LANGUAGE matters: without it whisper assumes English and TRANSLATES the
# audio instead of transcribing it.
WHISPER_BINARY=bin/whisper/Release/whisper-cli.exe
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt
TTS_VOICE_ID=pt-BR-ThalitaMultilingualNeural
FFMPEG_BINARY=ffmpeg
EDGE_TTS_BINARY=edge-tts
